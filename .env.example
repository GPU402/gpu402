# GPU402 configuration. Copy to .env, or run `pnpm setup:wallets` to create .env with fresh testnet wallets.

# ---- Lium (Bittensor Subnet 51) -------------------------------------------
# A Lium API key with read, rent and manage scopes: lium.io → Access → API Keys.
# Used by the gateway (its own paying account) and by the SDK quickstart.
LIUM_API_KEY=

# ---- x402 gateway -----------------------------------------------------------
PORT=4020
# Behind a reverse proxy: read client IPs from X-Forwarded-For for rate limiting.
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=60
# CAIP-2 network. Base Sepolia for the demo; Base mainnet is eip155:8453 (needs a mainnet facilitator).
X402_NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
# Wallet that receives agents' USDC.
GATEWAY_PAY_TO=
# Optional: the private key of GATEWAY_PAY_TO, used only to refund agents whose pod never started.
# Needs a little Base Sepolia ETH for gas.
REFUND_PRIVATE_KEY=
MARGIN=0.10
MAX_BLOCK_PRICE_USD=1
MAX_ACTIVE_PODS=5
RESERVE_USD=0.5
# Only sell these models (comma separated). Empty = every model on Lium.
ALLOWED_GPUS=
SWEEP_INTERVAL_MS=30000
DB_PATH=./data/gpu402.db

# ---- Agent demo -------------------------------------------------------------
# The agent's wallet: holds Base Sepolia USDC (faucet.circle.com), no Lium account.
AGENT_PRIVATE_KEY=
GPU402_GATEWAY_URL=http://localhost:4020
# Model for the demo agent: google (free tier at aistudio.google.com/apikey) or anthropic.
AGENT_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override; defaults to gemini-flash-latest (google) or claude-sonnet-5-5 (anthropic).
AGENT_MODEL=

# ---- Dashboard --------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4020
