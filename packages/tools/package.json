{
  "name": "@gpu402/tools",
  "version": "0.1.0",
  "description": "Drop-in GPU tools for AI agents (Vercel AI SDK and LangChain.js): rentGpu, runOnGpu, stopGpu. Key mode uses your Lium key; x402 mode pays per use in USDC with no account.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./package.json": "./package.json",
    "./tao": {
      "types": "./dist/tao.d.ts",
      "import": "./dist/tao.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "gpu402": "workspace:*",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "ai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.2",
    "ai": "^7.0.157",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GPU402/gpu402.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/GPU402/gpu402#readme",
  "bugs": {
    "url": "https://github.com/GPU402/gpu402/issues"
  },
  "author": "rythmern02"
}
