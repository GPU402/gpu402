{
  "name": "@gpu402/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "x402 gateway that sells Lium GPU time in prepaid 15-minute blocks, paid in USDC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@polkadot/api": "^17.0.2",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/hono": "^2.29.0",
    "gpu402": "workspace:*",
    "hono": "^4.13.14",
    "viem": "^2.57.13",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@x402/fetch": "^2.29.0",
    "vitest": "^5.0.5",
    "@gpu402/tools": "workspace:*"
  }
}
